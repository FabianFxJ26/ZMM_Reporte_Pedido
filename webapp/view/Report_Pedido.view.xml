<mvc:View
    controllerName="conconcentro.purchases.controller.Report_Pedido"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
>
    <Page
        id="page"
        title="{i18n>title}"
    >
        <VBox class="sapUiSmallMargin">
            <Title
                text="Reporte de Pedidos"
                level="H2"
            />

            <Table
                id="reportTable"
                inset="false"
                headerText="Entradas de Pedido"
                mode="None"
                growing="true"
                growingScrollToLoad="true"
                items="{path: '/YY1_REPORTE_ENTRADAS_PEDID'}"
            >
                <columns>
                    <Column>
                        <Text text="Pedido" />
                    </Column>
                    <Column>
                        <Text text="Fecha Clave" />
                    </Column>
                    <Column>
                        <Text text="Proveedor" />
                    </Column>
                    <Column>
                        <Text text="Nombre del proveedor" />
                    </Column>
                    <Column>
                        <Text text="Elemento PEP" />
                    </Column>
                    <Column>
                        <Text text="Nombre del elemento PEP" />
                    </Column>
                    <Column>
                        <Text text="Moneda" />
                    </Column>
                    <Column>
                        <Text text="Valor total del pedido con IVA" />
                    </Column>
                    <Column>
                        <Text text="Valor pendiente por entregar con IVA" />
                    </Column>
                    <Column>
                        <Text text="Valor entregado con IVA" />
                    </Column>
                    <Column>
                        <Text text="Cantidad del pedido" />
                    </Column>
                </columns>

                <items>
                    <ColumnListItem>
                        <Text text="{PurchaseOrder}" />
                        <Text
                            text="{
                                    path: 'CreationDate',
                                    type: 'sap.ui.model.type.Date',
                                    formatOptions: {
                                        pattern: 'dd/MM/yyyy'
                                    }
                                    }"
                        />
                        <Text text="{Supplier}" />
                        <Text text="{SupplierName}" />
                        <Text text="{WBSElementExternalID}" />
                        <Text text="{WBSDescription}" />
                        <Text text="{DocumentCurrency}" />
                        <Text text="{EffectiveAmount}" />
                        <Text text="{ValorPendiente}" />
                        <Text text="{ValorEntregado}" />
                        <Text text="{OrderQuantity}" />
                    </ColumnListItem>
                </items>
            </Table>
        </VBox>
    </Page>
</mvc:View>
