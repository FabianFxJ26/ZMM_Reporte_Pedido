<mvc:View xmlns:mvc="sap.ui.core.mvc" xmlns="sap.m" controllerName="conconcentro.purchases.controller.Report_Pedido">
  <Page id="page" title="{i18n>title}">
    <VBox class="sapUiSmallMargin" fitContainer="true">

<HBox class="sapUiSmallMarginBottom" justifyContent="SpaceBetween" alignItems="Center" fitContainer="false" width="100%">
  <VBox width="30%">
    <Label text="Proveedor" labelFor="searchField"/>
    <SearchField id="searchField" placeholder="Ej. 48300002" width="100%" search="onSearch"/>
  </VBox>

  <VBox width="30%">
    <Label text="Pedido" labelFor="inputPedido"/>
    <Input id="inputPedido" placeholder="Ej. 4500000013" width="100%" change="onSearch"/>
  </VBox>

  <VBox width="30%">
    <Label text="Elemento PEP" labelFor="inputElementoPEP"/>
    <Input id="inputElementoPEP" placeholder="Ej. I.01" width="100%" change="onSearch"/>
  </VBox>
</HBox>
<Button text="Exportar a Excel" icon="sap-icon://excel-attachment" press="onExport" class="sapUiTinyMarginBottom"/> 
      <Table id="reportTable" inset="false" headerText="Entradas de Pedido" mode="None" growing="true" growingScrollToLoad="true" items="{path: '/YY1_REPORTE_ENTRADAS_PEDID'}">
        
        <columns>
          <Column><Text text="Pedido"/></Column>
          <Column><Text text="Fecha Clave"/></Column>
          <Column><Text text="Proveedor"/></Column>
          <Column><Text text="Nombre del proveedor"/></Column>
          <Column><Text text="Elemento PEP"/></Column>
          <Column><Text text="Nombre del elemento PEP"/></Column>
          <Column><Text text="Moneda"/></Column>
          <Column><Text text="Valor total del pedido con IVA"/></Column>
          <Column><Text text="Valor pendiente por entregar con IVA"/></Column>
          <Column><Text text="Valor entregado con IVA"/></Column>
          <Column><Text text="Cantidad del pedido"/></Column>
        </columns>
        
        <items>
          <ColumnListItem>
            <Text text="{PurchaseOrder}"/>
            <Text text="{ path: 'CreationDate', type: 'sap.ui.model.type.Date', formatOptions: { pattern: 'dd/MM/yyyy' } }"/>
            <Text text="{Supplier}"/>
            <Text text="{SupplierName}"/>
            <Text text="{WBSElementExternalID}"/>
            <Text text="{WBSDescription}"/>
            <Text text="{DocumentCurrency}"/>
            <Text text="{EffectiveAmount}"/>
            <Text text="{ValorPendiente}"/>
            <Text text="{ValorEntregado}"/>
            <Text text="{OrderQuantity}"/>
          </ColumnListItem>
        </items>
      </Table>
    </VBox>
  </Page>
</mvc:View>