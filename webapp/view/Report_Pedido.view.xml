<mvc:View
  controllerName="conconcentro.purchases.controller.Report_Pedido"
  xmlns:mvc="sap.ui.core.mvc"
  xmlns="sap.m"
  xmlns:core="sap.ui.core"
  displayBlock="true">

  <Page id="pgAplicacion" title="Reporte de Pedidos" class="sapUiContentPadding" showFooter="false">

    <content>
     
      <VBox id="vbGeneral" class="sapUiSmallMarginBottom">
        <HBox id="vbSub" alignItems="Center">
          <VBox id="vbProveedor" width="20%">
            <Label id="lbProveedor" text="Proveedor" labelFor="searchField"/>
            <Input id="searchField" placeholder="Ej. 48300002" width="100%"/>
          </VBox>

          <VBox id="vbPedido" width="20%" class="sapUiTinyMarginBegin">
            <Label id="lblPedido" text="Pedido" labelFor="inputPedido"/>
            <Input id="inputPedido" placeholder="Ej. 4500000013" width="100%"/>
          </VBox>

          <VBox id="vbElementoPEP" width="20%" class="sapUiTinyMarginBegin">
            <Label id="lblElementoPEP" text="Elemento PEP" labelFor="inputElementoPEP"/>
            <Input id="inputElementoPEP" placeholder="Ej. I.01" width="100%"/>
          </VBox>

          <VBox id="vbBotones" width="40%" class="sapUiTinyMarginBegin">
            <HBox id="vbSubBotones" justifyContent="End" alignItems="Center">
              <Button id="btnBuscar" text="Buscar" icon="sap-icon://search" type="Emphasized" press="onSearch"/>
              <Button id="btnLimpiarFiltros" text="Limpiar filtros" icon="sap-icon://decline" class="sapUiTinyMarginBegin" press="onClearFilters"/>
              <Button id="btnExportarExcel" text="Exportar Excel" icon="sap-icon://excel-attachment" class="sapUiTinyMarginBegin" press="onExport"/>
            </HBox>
          </VBox>
        </HBox>
      </VBox>

     
      <Toolbar id="tlTotales">
        <Label id="lblValorTotalPedidosConIVAPedido" text="Valor total del pedido con IVA:" />
        <Text id="effectiveAmountPurchaseOrder" text="0.00" class="sapMTextStrong sapUiTinyMarginEnd" />

        <ToolbarSpacer id="tlEspacio"/>

        <Label id="lblValorTotalPedidosProveedor" text="Valor total pedidos del proveedor:" />
        <Text id="effectiveAmountSupplier" text="0.00" class="sapMTextStrong" />
      </Toolbar>

      <Table id="reportTable" inset="false" headerText="Entradas de Pedido" mode="None" growing="true" growingScrollToLoad="true" items="{path: '/YY1_REPORTE_ENTRADAS_PEDID'}">
      <columns>
          <Column id="clPedido"><Text id="txtPedido" text="Pedido"/></Column>
          <Column id="clFechaClave"><Text id="fechaClave" text="Fecha Clave"/></Column>
          <Column id="clProveedor"><Text id="txtProveedor" text="Proveedor"/></Column>
          <Column id="clNombreProveedor"><Text id="txtNombreProveedor" text="Nombre del proveedor"/></Column>
          <Column id="clElementoPEP"><Text id="txtElementoPEP" text="Elemento PEP"/></Column>
          <Column id="clNombreElementoPEP"><Text id="txtNombreElementoPEP" text="Nombre del elemento PEP"/></Column>
          <Column id="clMoneda"><Text id="txtMoneda" text="Moneda"/></Column>
          <Column id="clValorTotalDelPedidoConIVA"><Text id="txtValorTotalDelPedidoConIVA" text="Valor total del pedido con IVA"/></Column>
          <Column id="clValorPendientePorEntregarConIVA"><Text id="txtValorPendientePorEntregarConIVA" text="Valor pendiente por entregar con IVA"/></Column>
          <Column id="clValorEntregadoConIVA"><Text id="txtValorEntregadoConIVA" text="Valor entregado con IVA"/></Column>
          <Column id="clCantidadDelPedido"><Text id="txtCantidadDelPedido" text="Cantidad del pedido"/></Column>
        </columns>

        <items>
         <ColumnListItem id="clValues">
            <cells>
              <Link id="lkPurchaseOrder" text="{PurchaseOrder}" press="onPedidoPress"/>
              <Text id="txtCreationDate" text="{ path: 'CreationDate', type: 'sap.ui.model.type.Date', formatOptions: { pattern: 'dd/MM/yyyy' } }"/>
              <Text id="txtSupplier" text="{Supplier}"/>
              <Text id="txtSupplierName" text="{SupplierName}"/>
              <Text id="txtWBSElementExternalID" text="{WBSElementExternalID}"/>
              <Text id="txtWBSDescription" text="{WBSDescription}"/>
              <Text id="txtDocumentCurrency" text="{DocumentCurrency}"/>
              <Text id="txtEffectiveAmount" text="{EffectiveAmount}"/>
              <Text id="txtValorPendiente" text="{ValorPendiente}"/>
              <Text id="txtValorEntregado" text="{ValorEntregado}"/>
              <Text id="txtOrderQuantity" text="{OrderQuantity}"/>
            </cells>
          </ColumnListItem>
        </items>
      </Table>
    </content>
  </Page>
</mvc:View>